{
  "name": "restaurant-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:local": "tsx scripts/db-local.mts",
    "db:bootstrap": "tsx scripts/db-bootstrap.mts",
    "db:migrate": "tsx scripts/migrate.mts",
    "auth:schema": "pnpm dlx auth@latest generate --adapter drizzle --dialect postgresql --config scripts/auth-schema.config.ts --output src/db/schema/auth.ts -y",
    "db:seed": "tsx scripts/seed.mts",
    "db:seed:demo": "tsx scripts/seed-demo.mts",
    "worker": "tsx scripts/worker.mts",
    "setup": "pnpm db:bootstrap && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.25",
    "better-auth": "1.7.25",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  }
}
