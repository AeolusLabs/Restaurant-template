# Copy to .env and fill in. Secrets live only here, never in code.
# Local development defaults are produced by `pnpm db:local` (Task 4).

# Database: four roles (see docs/ARCHITECTURE.md section 11)
DATABASE_URL=postgres://app:CHANGE_ME@localhost:55432/restaurant
DATABASE_UNPOOLED_URL=postgres://app:CHANGE_ME@localhost:55432/restaurant
DATABASE_SYSTEM_URL=postgres://system:CHANGE_ME@localhost:55432/restaurant
DATABASE_MIGRATOR_URL=postgres://migrator:CHANGE_ME@localhost:55432/restaurant
# Superuser, used only by `pnpm db:bootstrap` to create the three roles above
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:55432/postgres

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-chars
APP_URL=http://localhost:3000

# Providers. Each defaults to a local fake, so the app runs with none of these set.
PAYMENT_PROVIDER=mock            # mock | paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
DELIVERY_PROVIDER=mock           # mock | chowdeck
CHOWDECK_API_KEY=
CHOWDECK_BASE_URL=               # no default: the docs list two hosts, confirm with a live call
CHOWDECK_WEBHOOK_SECRET=
NOTIFICATION_PROVIDER=stub
EMAIL_PROVIDER=mock               # mock prints to the server log; add an adapter to send real email
LLM_PROVIDER=mock             # mock | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                # no default: pick the model on purpose and price it in config (agents.modelPrices)
ANTHROPIC_BASE_URL=
STORAGE_PROVIDER=memory          # memory | s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Perimeter (leave empty in local development)
# Turnstile: the secret checks answers on the server, the site key shows the widget. Set both or neither.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ORIGIN_LOCK_SECRET=

# First owner, created by `pnpm db:seed` when both are set
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
